# Composer dependencies
/vendor/

# Environment files
.env
.env.*

# IDE/editor files
.vscode/
.idea/

# OS files
Thumbs.db
.DS_Store

# Cache, logs, sessions, temp
/storage/cache/
/storage/logs/
/storage/sessions/
/storage/tmp/

# Uploaded assets
/public/assets/avatars/

# Node/npm files
node_modules/
npm-debug.log*

# Build artifacts
*.log
*.tmp

# Misc
*.swp
*.bak

# Ignore coverage reports
coverage/

# Ignore user-specific files
*.sublime-workspace
*.sublime-project

# Gallery media. A symlink to the storage mount in production, and a real
# directory if you point GALLERY_STORAGE_PATH somewhere local. Either way it
# holds uploads, chunk staging (.uploads), transcode locks (.locks) and
# per-year .processing markers — none of which belong in the repo.
/gallery-storage
